programa {
  inteiro a1,a2,a3 
  funcao inicio() {
    
escreva ("Escreva um numero : ")
leia (a1)

escreva("Escreva outro numero : ")
leia (a2)

escreva("Escreva mais um numero : ")
leia (a3)




se ( (a1<a2+a3) e (a2<a1+a3) e (a3<a1+a2) ){

escreva ("E possivel faser um triangulo. ")

}

senao{


escreva ("Não e possivel faser um triangulo. ")



} 


  }
}
